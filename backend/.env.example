# Server
PORT=3000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database and cache
MONGODB_URI=mongodb://localhost:27017/care_connect_db
REDIS_URL=redis://localhost:6379

# JWT
ACCESS_TOKEN_SECRET=change_me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change_me_too
REFRESH_TOKEN_EXPIRY=7d

# Firebase Admin (use one of these)
FIREBASE_SERVICE_ACCOUNT_PATH=./dbconfig/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# AWS S3 (documents)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
S3_URL_EXPIRATION=3600

# Cloudinary
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
